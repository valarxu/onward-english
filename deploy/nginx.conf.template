server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/onward-english/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://__DOMAIN__$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;
    root /var/www/onward-english/current;
    index index.html;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location = /healthz { access_log off; default_type text/plain; return 200 'ok\n'; }
    location = /index.html { add_header Cache-Control 'no-cache'; }
    location ~* \.(js|css)$ { add_header Cache-Control 'public, max-age=300'; try_files $uri =404; }
    location ~ /\. { deny all; }
    location / { try_files $uri $uri/ =404; }
}
